{
  "name": "wordle-multiplayer",
  "version": "1.0.0",
  "description": "Real-time multiplayer Wordle game",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently --names \"server,client\" --prefix-colors \"magenta,cyan\" \"node server/index.js\" \"vite --port 5173\"",
    "server": "node server/index.js",
    "client": "vite --port 5173",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "vite": "^5.0.0"
  }
}
